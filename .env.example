# ──────────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────────
# Controls which locale to use by default (en | th)
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Set to "true" to use in-memory mock implementations instead of
# real Supabase calls. Keep true during local front-end development.
NEXT_PUBLIC_USE_MOCKS=true

# ──────────────────────────────────────────────────────────────────
# Supabase  (fill in when connecting the real back-end)
# ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only – never commit real values
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ──────────────────────────────────────────────────────────────────
# Scores CSV
# Used by site.config.ts → scoresCsvUrl (overrides the config default)
# ──────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SCORES_CSV_URL=https://example.com/scores.csv
